{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "[STORED_IN_USER_SECRETS]"
  },
  "JwtSettings": {
    "Issuer": "TanishElectronics.Api",
    "Audience": "TanishElectronics.Web",
    "SecretKey": "[STORED_IN_USER_SECRETS]",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "ShopSettings": {
    "DefaultPublicAnnouncementLimit": 5,
    "MaxPublicAnnouncementLimit": 10
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromName": "Tanish Electronics"
  },
  "Otp": {
    "ExpiryMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "ResetTokenExpiryMinutes": 10
  },
  "Groq": {
    "ApiKey": "[STORED_IN_USER_SECRETS]",
    "Model": "openai/gpt-oss-20b",
    "MaxTokens": 400
  }
}
